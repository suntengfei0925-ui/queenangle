page {
  background: #f6f7f9;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.sub-title {
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  color: #6b7280;
}

.danger {
  color: #b91c1c;
}

.success {
  color: #047857;
}

.money {
  font-family: "DIN Alternate", "Segoe UI", sans-serif;
  font-weight: 700;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.label {
  color: #374151;
  font-size: 26rpx;
}

.input,
.textarea {
  min-height: 84rpx;
  box-sizing: border-box;
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #ffffff;
  padding: 18rpx 20rpx;
}

.textarea {
  min-height: 144rpx;
}

.select-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.select-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  box-sizing: border-box;
  border: 2rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #ffffff;
  padding: 18rpx 20rpx;
  color: #111827;
}

.select-option.active {
  border-color: #10b981;
  background: #ecfdf5;
  color: #065f46;
  font-weight: 600;
}

.select-option-title {
  flex: 1;
  min-width: 0;
  color: inherit;
  word-break: break-all;
}

.select-option-meta {
  flex-shrink: 0;
  max-width: 48%;
  color: #6b7280;
  font-size: 24rpx;
  text-align: right;
  word-break: break-all;
}

.select-option.active .select-option-meta {
  color: #047857;
}

.payment-qr-code {
  align-self: center;
  width: 360rpx;
  height: 360rpx;
  max-width: 100%;
  margin-top: 10rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row button {
  flex: 1;
}

button.primary {
  background: #111827;
  color: #ffffff;
}

button.secondary {
  background: #ffffff;
  color: #111827;
  border: 1rpx solid #d1d5db;
}

button.danger-btn {
  background: #fee2e2;
  color: #991b1b;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  background: #eef2ff;
  color: #3730a3;
  font-size: 22rpx;
}

.tag.gray {
  background: #f3f4f6;
  color: #4b5563;
}

.tag.red {
  background: #fee2e2;
  color: #991b1b;
}

.empty {
  padding: 56rpx 24rpx;
  color: #6b7280;
  text-align: center;
}

.compact-empty {
  padding: 28rpx 16rpx;
}

