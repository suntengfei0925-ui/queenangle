<view class="page">
  <view class="panel stack">
    <view class="title">当前微信用户未开通权限</view>
    <view class="muted">请提交申请，或复制 openid 发给老板开通。</view>
    <view class="openid-box">
      <view class="label">当前 openid</view>
      <view class="openid-text">{{openid || "-"}}</view>
    </view>
    <view wx:if="{{applicationMessage}}" class="notice success">{{applicationMessage}}</view>
    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitApplication">申请开通权限</button>
    <button class="primary" bindtap="copyOpenid">复制 openid</button>
    <button class="secondary" bindtap="checkAgain">重新检查</button>
  </view>
</view>

