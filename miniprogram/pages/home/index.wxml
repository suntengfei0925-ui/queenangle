<view class="page">
  <view class="section panel stack">
    <view class="row">
      <view>
        <view class="title">今日流水</view>
        <view class="muted">{{businessDate}}</view>
      </view>
      <button class="secondary summary-toggle" size="mini" bindtap="toggleSummary">{{summaryExpanded ? '折叠' : '展开'}}</button>
    </view>
    <view wx:if="{{summaryExpanded}}" class="stack">
      <view class="row">
        <view>
          <view class="muted">今日实收</view>
          <view class="money title">¥{{summary.actualReceivedYuan}}</view>
        </view>
        <view>
          <view class="muted">有效笔数</view>
          <view class="money title">{{summary.activeCount}}</view>
        </view>
      </view>
      <view class="row">
        <view>
          <view class="muted">消费金额</view>
          <view class="money">¥{{summary.consumptionYuan}}</view>
        </view>
        <view>
          <view class="muted">余额支付</view>
          <view class="money">¥{{summary.balancePayYuan}}</view>
        </view>
        <view>
          <view class="muted">充值</view>
          <view class="money">¥{{summary.rechargeYuan}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="row section">
      <view class="sub-title">今日记录</view>
      <button class="primary" size="mini" bindtap="goEntry">记一笔</button>
    </view>
    <view wx:if="{{records.length === 0}}" class="empty">今天还没有记录</view>
    <view class="list" wx:else>
      <view class="list-item" wx:for="{{records}}" wx:key="_id" bindtap="goRecord" data-id="{{item._id}}">
        <view class="row">
          <view class="sub-title">{{item.typeText}}</view>
          <view class="tag {{item.status === 'void' ? 'red' : 'gray'}}">{{item.statusText}}</view>
        </view>
        <view class="muted">{{item.nameLine}}</view>
        <view class="row">
          <view class="money">实收 ¥{{item.actualReceivedYuan}}</view>
          <view class="muted">{{item.paymentText}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

