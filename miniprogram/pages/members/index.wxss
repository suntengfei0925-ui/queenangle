.select-member-page {
  padding-bottom: 140rpx;
}

.member-list {
  gap: 10rpx;
}

.member-item {
  padding: 14rpx 18rpx;
}

.member-name,
.member-phone {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-phone {
  margin-top: 4rpx;
}

.fixed-action {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.add-member-btn {
  width: 100%;
  min-height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
