<view class="page select-member-page">
  <view class="section panel stack">
    <view class="title">选择会员</view>
    <input class="input" placeholder="按姓名、手机号或后四位搜索" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="loadMembers" />
  </view>

  <view wx:if="{{members.length === 0}}" class="empty">暂无会员</view>
  <view class="list" wx:else>
    <view class="list-item" wx:for="{{members}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
      <view class="row">
        <view>
          <view class="sub-title">{{item.name}}</view>
          <view class="muted">{{item.phone}}</view>
        </view>
        <view class="tag">{{item.discountText}}</view>
      </view>
      <view class="row">
        <view class="money">余额 ¥{{item.balanceYuan}}</view>
        <view class="muted">次卡 {{item.cardTotal}} 次</view>
      </view>
    </view>
  </view>

  <view class="fixed-action">
    <button class="secondary add-member-btn" bindtap="addMember">新建会员</button>
  </view>
</view>

