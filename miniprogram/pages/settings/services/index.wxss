
.settings-config-page {
  padding-bottom: 140rpx;
}

.readonly-value {
  min-height: 84rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  background: #f9fafb;
  padding: 18rpx 20rpx;
  color: #374151;
}

.service-group {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-header {
  align-items: flex-start;
}

.group-list {
  display: flex;
  flex-direction: column;
}

.service-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #e5e7eb;
}

.service-row:first-child {
  border-top: 0;
  padding-top: 0;
}

.service-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.service-main {
  min-width: 0;
}

.service-remark {
  margin-top: 8rpx;
}

.service-actions {
  margin-top: 16rpx;
}

.group-action {
  display: flex;
  justify-content: flex-start;
}

.add-service-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  font-size: 26rpx;
}
