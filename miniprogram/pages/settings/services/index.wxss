.settings-config-page {
  padding-bottom: 140rpx;
}

.readonly-value {
  min-height: 84rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  background: #f9fafb;
  padding: 18rpx 20rpx;
  color: #374151;
}

.service-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.group-header {
  align-items: center;
}

.group-list {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid #e5e7eb;
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 66rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.service-row.is-disabled .service-name {
  color: #9ca3af;
}

.service-main {
  flex: 1;
  min-width: 0;
}

.service-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-action {
  display: flex;
  justify-content: flex-start;
}

.add-service-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  font-size: 26rpx;
}
