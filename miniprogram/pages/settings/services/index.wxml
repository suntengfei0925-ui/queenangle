<view class="page settings-config-page">
  <view wx:if="{{mode === 'form'}}" class="section panel form">
    <view class="sub-title">
      <block wx:if="{{form.id}}">编辑服务项目</block>
      <block wx:else>新增{{form.categoryName}}项目</block>
    </view>
    <view class="field">
      <view class="label">所属分类</view>
      <view class="readonly-value">{{form.categoryName}}</view>
    </view>
    <view class="field">
      <view class="label">项目名称</view>
      <input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="例如 纯色" />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <input class="input" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="可选" />
    </view>
    <view class="button-row">
      <button class="primary" bindtap="save">保存</button>
      <button class="secondary" bindtap="backToList">返回</button>
    </view>
  </view>

  <block wx:else>
    <view class="section panel service-group" wx:for="{{serviceGroups}}" wx:key="name">
      <view class="row group-header">
        <view class="sub-title">{{item.name}}</view>
        <view class="muted">{{item.services.length}} 项</view>
      </view>

      <view wx:if="{{item.services.length === 0}}" class="empty">暂无服务项目</view>
      <view wx:else class="group-list">
        <view
          class="service-row {{service.enabled && service.categoryEnabled ? '' : 'is-disabled'}}"
          wx:for="{{item.services}}"
          wx:for-item="service"
          wx:key="_id"
        >
          <view class="service-main">
            <view class="sub-title service-name">{{service.name}}</view>
          </view>
          <view wx:if="{{!service.isOther}}" class="inline-actions service-actions">
            <button class="secondary inline-btn" size="mini" catchtap="edit" data-id="{{service._id}}">编辑</button>
            <button class="inline-btn {{service.enabled ? 'red-btn' : 'green-btn'}}" size="mini" catchtap="toggle" data-id="{{service._id}}" data-enabled="{{!service.enabled}}">
              {{service.enabled ? "停用" : "启用"}}
            </button>
          </view>
        </view>
      </view>

      <view class="group-action">
        <button
          class="secondary add-service-btn"
          bindtap="startAdd"
          data-category-id="{{item.categoryId}}"
          data-category-name="{{item.name}}"
          disabled="{{!item.categoryId}}"
        >
          新增{{item.name}}项目
        </button>
      </view>
    </view>
  </block>
</view>
