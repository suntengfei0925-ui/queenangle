.settings-config-page {
  padding-bottom: 140rpx;
}

.config-list {
  display: flex;
  flex-direction: column;
  padding-top: 0;
  padding-bottom: 0;
}

.config-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.config-row:last-child {
  border-bottom: 0;
}

.config-row.is-disabled .config-title,
.config-row.is-disabled .config-meta {
  color: #9ca3af;
}

.config-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.config-title,
.config-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fixed-action {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.add-config-btn {
  width: 100%;
  min-height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
