<view class="page">
  <view class="entry-list">
    <view class="entry-card member-card" bindtap="goPage" data-url="/pages/members/index">
      <view>
        <view class="entry-title">会员</view>
        <view class="entry-desc">先选择会员，再办理消费结账或充值</view>
      </view>
      <view class="entry-arrow">进入</view>
    </view>

    <view class="entry-card guest-card" bindtap="goPage" data-url="/pages/guest-consumption/index">
      <view>
        <view class="entry-title">散客结账</view>
        <view class="entry-desc">不绑定会员，直接记录本次结账</view>
      </view>
      <view class="entry-arrow">进入</view>
    </view>
  </view>
</view>

