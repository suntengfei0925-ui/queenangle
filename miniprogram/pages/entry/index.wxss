
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 32rpx 28rpx;
}

.member-card {
  min-height: 260rpx;
  background: #111827;
  color: #ffffff;
}

.guest-card {
  min-height: 170rpx;
}

.entry-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
}

.entry-desc {
  margin-top: 14rpx;
  color: #6b7280;
  line-height: 1.5;
}

.member-card .entry-desc {
  color: #d1d5db;
}

.entry-arrow {
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 600;
}
