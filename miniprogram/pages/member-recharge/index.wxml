<view class="page">
  <view class="section panel member-summary">
    <view>
      <view class="label">已选会员</view>
      <view class="sub-title">{{selectedMember.name}}</view>
      <view class="muted">{{selectedMember.phone}}</view>
    </view>
    <view class="summary-grid">
      <view>
        <view class="muted">当前余额</view>
        <view class="money">¥{{selectedMember.balanceYuan}}</view>
      </view>
      <view>
        <view class="muted">当前折扣</view>
        <view>{{selectedMember.discountText}}</view>
      </view>
      <view>
        <view class="muted">次卡</view>
        <view>{{selectedMember.cardTotal}} 次</view>
      </view>
    </view>
  </view>

  <view class="panel form">
    <view class="field">
      <view class="label">充值档位</view>
      <view class="select-list">
        <view
          wx:for="{{tiers}}"
          wx:key="_id"
          class="select-option {{item._id === selectedTier._id ? 'active' : ''}}"
          bindtap="onTierChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">充 ¥{{item.amountYuan}}</view>
          <view class="select-option-meta">享 {{item.discountLabel}}</view>
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">支付方式</view>
      <view class="select-list">
        <view
          wx:for="{{paymentMethods}}"
          wx:key="value"
          class="select-option {{item.value === selectedPayment.value ? 'active' : ''}}"
          bindtap="onPaymentChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.label}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{selectedTier._id}}" class="tier-summary">
      <view class="row">
        <view class="muted">余额增加</view>
        <view class="money">¥{{selectedTier.amountYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">充值后折扣</view>
        <view>{{selectedTier.discountLabel}}</view>
      </view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.remark}}" bindinput="onRemarkInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="submit">保存记录</button>
  </view>
</view>

