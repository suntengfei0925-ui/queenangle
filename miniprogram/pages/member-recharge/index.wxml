<view class="page">
  <view class="panel form">
    <view class="field">
      <view class="label">会员</view>
      <picker mode="selector" range="{{members}}" range-key="displayName" bindchange="onMemberChange">
        <view class="picker">{{selectedMember.displayName || "请选择会员"}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">充值档位</view>
      <picker mode="selector" range="{{tiers}}" range-key="displayName" bindchange="onTierChange">
        <view class="picker">{{selectedTier.displayName || "请选择充值档位"}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">支付方式</view>
      <picker mode="selector" range="{{paymentMethods}}" range-key="label" bindchange="onPaymentChange">
        <view class="picker">{{selectedPayment.label || "请选择支付方式"}}</view>
      </picker>
    </view>
    <view wx:if="{{selectedTier._id}}" class="panel">
      <view class="row">
        <view class="muted">余额增加</view>
        <view class="money">¥{{selectedTier.amountYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">充值后折扣</view>
        <view>{{selectedTier.discountLabel}}</view>
      </view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.remark}}" bindinput="onRemarkInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="submit">保存记录</button>
  </view>
</view>

