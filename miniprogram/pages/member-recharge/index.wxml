<view class="page">
  <view class="section panel member-summary">
    <view>
      <view class="label">已选会员</view>
      <view class="sub-title">{{selectedMember.name}}</view>
      <view class="muted">{{selectedMember.phone}}</view>
    </view>
    <view class="summary-grid">
      <view>
        <view class="muted">当前余额</view>
        <view class="money">¥{{selectedMember.balanceYuan}}</view>
      </view>
      <view>
        <view class="muted">当前折扣</view>
        <view>{{selectedMember.discountText}}</view>
      </view>
      <view>
        <view class="muted">次卡</view>
        <view>{{selectedMember.cardTotal}} 次</view>
      </view>
    </view>
  </view>

  <view class="panel form">
    <view wx:if="{{configError}}" class="empty compact-empty">{{configError}}</view>
    <block wx:else>
      <view class="field">
        <view class="label">充值档位</view>
        <view class="select-list">
          <view
            wx:for="{{tiers}}"
            wx:key="_id"
            class="select-option {{item._id === selectedTier._id ? 'active' : ''}}"
            bindtap="onTierChange"
            data-index="{{index}}"
          >
            <view class="select-option-title">充 ¥{{item.amountYuan}}</view>
            <view class="select-option-meta">享 {{item.discountLabel}}</view>
          </view>
        </view>
      </view>
      <view class="field">
        <view class="label">次卡充值</view>
        <view wx:if="{{cardTypes.length === 0}}" class="empty compact-empty">暂无可购买次卡</view>
        <view class="select-list" wx:else>
          <view
            wx:for="{{cardTypes}}"
            wx:key="_id"
            class="select-option {{item.selected ? 'active' : ''}}"
            bindtap="onCardTypeToggle"
            data-index="{{index}}"
          >
            <view class="select-option-title">{{item.name}}</view>
            <view class="select-option-meta">{{item.totalTimes}} 次 / ¥{{item.priceYuan}}</view>
          </view>
        </view>
      </view>
    </block>

    <view class="field">
      <view class="label">支付方式</view>
      <view class="select-list">
        <view
          wx:for="{{paymentMethods}}"
          wx:key="value"
          class="select-option {{item.value === selectedPayment.value ? 'active' : ''}}"
          bindtap="onPaymentChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.label}}</view>
        </view>
      </view>
      <image wx:if="{{selectedPayment.qrCodeSrc}}" class="payment-qr-code" src="{{selectedPayment.qrCodeSrc}}" mode="aspectFit" />
    </view>

    <view wx:if="{{selectedTier._id}}" class="tier-summary">
      <view class="sub-title">本次汇总</view>
      <view class="row">
        <view class="muted">余额增加</view>
        <view class="money">¥{{selectedTier.amountYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">充值后折扣</view>
        <view>{{selectedTier.discountLabel}}</view>
      </view>
      <view class="row">
        <view class="muted">实收金额</view>
        <view class="money">¥{{selectedTier.amountYuan}}</view>
      </view>
    </view>

    <view wx:if="{{selectedCards.length > 0}}" class="tier-summary">
      <view class="sub-title">本次汇总</view>
      <view wx:for="{{selectedCards}}" wx:key="_id" class="row card-summary-row">
        <view>{{item.name}}</view>
        <view class="money">+{{item.totalTimes}} 次 / ¥{{item.priceYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">合计次数</view>
        <view>{{cardSummary.totalTimes}} 次</view>
      </view>
      <view class="row">
        <view class="muted">实收金额</view>
        <view class="money">¥{{cardSummary.totalYuan}}</view>
      </view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <input class="input" value="{{form.remark}}" bindinput="onRemarkInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="submit" disabled="{{submitting}}">完成充值</button>
  </view>
</view>

