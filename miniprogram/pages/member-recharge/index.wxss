
.member-summary {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.tier-summary {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 20rpx;
  background: #f9fafb;
}
