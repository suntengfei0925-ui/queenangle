
.member-summary {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.tier-summary {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 20rpx;
  background: #f9fafb;
}

.card-summary-row {
  align-items: flex-start;
}

.card-summary-row > view:first-child {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.card-summary-row .money {
  flex-shrink: 0;
  text-align: right;
}
