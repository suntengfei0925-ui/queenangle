
.month-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
}

.selected-month-row {
  display: flex;
}

.choice-chip {
  flex-shrink: 0;
  min-height: 64rpx;
  box-sizing: border-box;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  padding: 14rpx 18rpx;
  background: #ffffff;
  color: #111827;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}

.selected-month {
  min-width: 112rpx;
}

.day-scroll {
  width: 100%;
  white-space: nowrap;
}

.day-grid {
  display: grid;
  grid-auto-flow: column;
  grid-template-rows: repeat(3, 64rpx);
  grid-auto-columns: 96rpx;
  gap: 12rpx;
}

.choice-chip.day-chip {
  min-width: 0;
}

.choice-chip.active {
  border-color: #10b981;
  background: #ecfdf5;
  color: #065f46;
  font-weight: 600;
}

.import-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 16rpx;
  background: #f9fafb;
}

.import-toggle {
  min-height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
}

.compact-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
}

.compact-label {
  width: 64rpx;
  flex-shrink: 0;
  color: #374151;
  font-size: 26rpx;
}

.compact-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.compact-controls {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mini-chip {
  flex-shrink: 0;
  min-width: 76rpx;
  min-height: 60rpx;
  box-sizing: border-box;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  padding: 12rpx 14rpx;
  background: #ffffff;
  color: #111827;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.mini-chip.active {
  border-color: #10b981;
  background: #ecfdf5;
  color: #065f46;
  font-weight: 600;
}

.compact-input {
  flex: 1;
  min-height: 68rpx;
  padding: 12rpx 16rpx;
}

.discount-input {
  flex: 0 0 132rpx;
  width: 132rpx;
}

.page-input {
  flex: 0 0 112rpx;
  width: 112rpx;
}
