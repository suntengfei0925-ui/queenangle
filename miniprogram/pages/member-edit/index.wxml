<view class="page">
  <view class="panel form">
    <view class="field">
      <view class="label">姓名</view>
      <input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="请输入会员姓名" />
    </view>
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" placeholder="请输入手机号" />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="save">保存</button>
  </view>
</view>

