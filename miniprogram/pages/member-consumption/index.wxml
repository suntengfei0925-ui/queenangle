<view class="page">
  <view class="panel form">
    <view class="field">
      <view class="label">会员</view>
      <picker mode="selector" range="{{members}}" range-key="displayName" bindchange="onMemberChange">
        <view class="picker">{{selectedMember.displayName || "请选择会员"}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">服务项目</view>
      <picker mode="selector" range="{{services}}" range-key="name" bindchange="onServiceChange">
        <view class="picker">{{selectedService.name || "请选择服务项目"}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">项目原价</view>
      <input class="input" value="{{form.originalAmountYuan}}" data-field="originalAmountYuan" bindinput="onInput" type="digit" placeholder="单位：元" />
    </view>
    <view wx:if="{{selectedMember._id && selectedService._id}}" class="panel stack">
      <view class="row">
        <view class="muted">当前余额</view>
        <view class="money">¥{{calc.balanceYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">当前折扣</view>
        <view>{{calc.discountText}}</view>
      </view>
      <view class="row">
        <view class="muted">本次消费金额</view>
        <view class="money">¥{{calc.payableYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">余额支付</view>
        <view class="money">¥{{calc.balancePayYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">补差价</view>
        <view class="money">¥{{calc.extraPayYuan}}</view>
      </view>
    </view>
    <view wx:if="{{calc.extraPayCent > 0}}" class="field">
      <view class="label">补差价支付方式</view>
      <picker mode="selector" range="{{paymentMethods}}" range-key="label" bindchange="onPaymentChange">
        <view class="picker">{{selectedPayment.label || "请选择支付方式"}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="submit">保存记录</button>
  </view>
</view>

