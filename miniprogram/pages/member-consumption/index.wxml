<view class="page">
  <view class="section panel member-summary">
    <view>
      <view class="label">已选会员</view>
      <view class="sub-title">{{selectedMember.name}}</view>
      <view class="muted">{{selectedMember.phone}}</view>
    </view>
    <view class="summary-grid">
      <view>
        <view class="muted">当前余额</view>
        <view class="money">¥{{selectedMember.balanceYuan}}</view>
      </view>
      <view>
        <view class="muted">当前折扣</view>
        <view>{{selectedMember.discountText}}</view>
      </view>
    </view>
  </view>

  <view class="panel form">
    <view class="service-person-row" bindtap="openServicePersonPicker">
      <view class="label">服务人</view>
      <view class="service-person-value">
        <text class="service-person-name">{{selectedServicePerson.name || '加载中'}}</text>
        <text class="service-person-arrow">></text>
      </view>
    </view>

    <view wx:if="{{availableCards.length > 0}}" class="field">
      <view class="label">可用次卡</view>
      <view class="card-option-list">
        <view
          wx:for="{{availableCards}}"
          wx:key="cardTypeId"
          class="card-option {{item.selected ? 'active' : ''}}"
          bindtap="toggleCard"
          data-id="{{item.cardTypeId}}"
        >
          <view class="select-option-title">{{item.cardName}}</view>
          <view class="select-option-meta">剩余 {{item.remainingTimes}} 次</view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="label">消费项目</view>
      <view wx:if="{{configError}}" class="empty compact-empty">{{configError}}</view>
      <view wx:else class="service-picker">
        <view class="category-list">
          <view
            wx:for="{{categories}}"
            wx:key="_id"
            class="category-item {{item._id === activeCategoryId ? 'active' : ''}}"
            bindtap="selectCategory"
            data-id="{{item._id}}"
          >
            {{item.name}}
          </view>
        </view>
        <scroll-view class="service-list" scroll-y="true" enhanced="true" show-scrollbar="true">
          <view class="service-list-inner">
            <view
              wx:for="{{activeServices}}"
              wx:key="_id"
              class="service-item"
              bindtap="addService"
              data-id="{{item._id}}"
            >
              <view class="service-name">{{item.name}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="field">
      <view class="label">已选内容</view>
      <view wx:if="{{selectedCards.length === 0 && selectedItems.length === 0}}" class="empty compact-empty">请选择次卡或服务项目</view>
      <view class="selected-list" wx:else>
        <view class="selected-item selected-card" wx:for="{{selectedCards}}" wx:for-item="card" wx:key="cardTypeId">
          <view class="selected-info selected-card-info">
            <view class="sub-title">{{card.cardName}}</view>
            <view class="muted">使用次卡</view>
          </view>
          <button class="secondary remove-btn" size="mini" bindtap="toggleCard" data-id="{{card.cardTypeId}}">移除</button>
        </view>
        <view class="selected-item" wx:for="{{selectedItems}}" wx:key="key">
          <view class="selected-info">
            <view class="sub-title">{{item.displayName}}</view>
            <input class="input price-input" value="{{item.originalAmountYuan}}" data-index="{{index}}" bindinput="onItemAmountInput" type="digit" placeholder="单项原价" />
          </view>
          <button class="secondary remove-btn" size="mini" bindtap="removeItem" data-index="{{index}}">移除</button>
        </view>
      </view>
    </view>

    <view wx:if="{{selectedMember._id && selectedItems.length > 0}}" class="calc-panel stack">
      <view class="row">
        <view class="muted">整单原价</view>
        <view class="money">¥{{calc.originalYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">当前余额</view>
        <view class="money">¥{{calc.balanceYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">当前折扣</view>
        <view>{{calc.discountText}}</view>
      </view>
      <view class="row">
        <view class="muted">本次消费金额</view>
        <view class="money">¥{{calc.payableYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">余额支付</view>
        <view class="money">¥{{calc.balancePayYuan}}</view>
      </view>
      <view class="row">
        <view class="muted">补差价</view>
        <view class="money">¥{{calc.extraPayYuan}}</view>
      </view>
    </view>
    <view wx:if="{{calc.extraPayCent > 0}}" class="field">
      <view class="label">补差价支付方式</view>
      <view class="select-list">
        <view
          wx:for="{{paymentMethods}}"
          wx:key="value"
          class="select-option {{item.value === selectedPayment.value ? 'active' : ''}}"
          bindtap="onPaymentChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.label}}</view>
        </view>
      </view>
      <image wx:if="{{selectedPayment.qrCodeSrc}}" class="payment-qr-code" src="{{selectedPayment.qrCodeSrc}}" mode="aspectFit" />
    </view>
    <view class="field">
      <view class="label">备注</view>
      <input class="input" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="可选" />
    </view>
    <view wx:if="{{signature.tempFilePath}}" class="signature-preview {{signature.valid ? '' : 'invalid'}}">
      <view class="row">
        <view>
          <view class="sub-title">客户已签字</view>
          <view wx:if="{{signature.valid}}" class="muted">再次点击完成结账后保存记录</view>
          <view wx:else class="danger">结账内容已修改，请重新签字</view>
        </view>
        <button class="secondary resign-btn" size="mini" bindtap="startSignatureFlow">重新签字</button>
      </view>
      <image class="signature-thumb" src="{{signature.tempFilePath}}" mode="aspectFit" bindtap="previewSignature" />
    </view>
    <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">完成结账</button>
  </view>

  <view wx:if="{{servicePersonPickerVisible}}" class="service-person-mask" bindtap="closeServicePersonPicker" catchtouchmove="noop">
    <view class="service-person-sheet" catchtap="noop">
      <view class="service-person-sheet-title">选择服务人</view>
      <view class="service-person-list">
        <view
          wx:for="{{servicePeople}}"
          wx:key="openid"
          class="service-person-option {{item.openid === selectedServicePerson.openid ? 'active' : ''}}"
          bindtap="selectServicePerson"
          data-openid="{{item.openid}}"
        >
          <view>{{item.name}}</view>
          <view wx:if="{{item.openid === selectedServicePerson.openid}}" class="service-person-check">已选</view>
        </view>
      </view>
      <button class="secondary service-person-cancel" bindtap="closeServicePersonPicker">取消</button>
    </view>
  </view>

  <view wx:if="{{checkoutConfirm.visible}}" class="modal-mask" catchtouchmove="noop">
    <view class="checkout-modal">
      <view class="modal-title">请确认本次会员结账</view>
      <scroll-view class="modal-scroll" scroll-y="true">
        <view class="confirm-section">
          <view class="confirm-row">
            <view class="muted">服务人</view>
            <view>{{checkoutConfirm.view.servicePersonName}}</view>
          </view>
        </view>

        <view class="confirm-section">
          <view class="confirm-section-title">余额变化</view>
          <view class="confirm-row">
            <view class="muted">期初余额</view>
            <view class="money">¥{{checkoutConfirm.view.balanceBeforeYuan}}</view>
          </view>
          <view class="confirm-row highlight-row">
            <view>余额支付</view>
            <view class="money danger">-¥{{checkoutConfirm.view.balancePayYuan}}</view>
          </view>
          <view class="confirm-row">
            <view class="muted">消费后余额</view>
            <view class="money">¥{{checkoutConfirm.view.balanceAfterYuan}}</view>
          </view>
        </view>

        <view wx:if="{{checkoutConfirm.view.hasServiceItems}}" class="confirm-section">
          <view class="confirm-section-title">消费金额</view>
          <view class="confirm-item-list">
            <view wx:for="{{checkoutConfirm.view.serviceItems}}" wx:key="key" class="confirm-item-row">
              <view>{{item.displayName}}</view>
              <view class="money">¥{{item.originalYuan}}</view>
            </view>
          </view>
          <view class="confirm-row">
            <view class="muted">项目原价合计</view>
            <view class="money">¥{{checkoutConfirm.view.originalYuan}}</view>
          </view>
          <view class="confirm-row">
            <view class="muted">当前折扣</view>
            <view>{{checkoutConfirm.view.discountText}}</view>
          </view>
          <view class="confirm-row highlight-row">
            <view>折后金额</view>
            <view class="money">¥{{checkoutConfirm.view.payableYuan}}</view>
          </view>
          <view class="confirm-row">
            <view class="muted">补差价</view>
            <view class="money">¥{{checkoutConfirm.view.extraPayYuan}}</view>
          </view>
          <view wx:if="{{checkoutConfirm.view.extraPaymentText !== '-'}}" class="confirm-row">
            <view class="muted">补差价支付方式</view>
            <view>{{checkoutConfirm.view.extraPaymentText}}</view>
          </view>
        </view>

        <view wx:if="{{checkoutConfirm.view.cardItems.length > 0}}" class="confirm-section">
          <view class="confirm-section-title">次卡变化</view>
          <view wx:for="{{checkoutConfirm.view.cardItems}}" wx:key="key" class="card-change">
            <view class="card-change-name">{{item.cardName}}</view>
            <view class="card-change-meta">
              <text class="danger">扣 {{item.useTimes}} 次</text>
              <text>使用后剩余 {{item.remainingTimesAfter}} 次</text>
            </view>
          </view>
        </view>

        <view wx:if="{{checkoutConfirm.view.hasRemark}}" class="confirm-section">
          <view class="confirm-section-title">备注</view>
          <view>{{checkoutConfirm.view.remark}}</view>
        </view>
      </scroll-view>
      <view class="modal-actions">
        <button class="secondary" bindtap="cancelCheckoutConfirm">返回修改</button>
        <button class="primary" bindtap="confirmAndSign">确认并签字</button>
      </view>
    </view>
  </view>
</view>
