.member-summary {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.service-picker {
  display: grid;
  grid-template-columns: 168rpx 1fr;
  height: 432rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
  background: #ffffff;
}

.category-list {
  max-height: 432rpx;
  overflow-y: auto;
  background: #f9fafb;
  border-right: 1rpx solid #e5e7eb;
}

.category-item {
  padding: 20rpx 16rpx;
  color: #4b5563;
  border-bottom: 1rpx solid #e5e7eb;
  word-break: break-all;
}

.category-item.active {
  background: #ffffff;
  color: #111827;
  font-weight: 600;
}

.service-list {
  height: 432rpx;
  box-sizing: border-box;
  padding: 12rpx;
}

.service-list-inner {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  padding: 0 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  box-sizing: border-box;
  text-align: center;
}

.service-name {
  max-width: 4.5em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.selected-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-info {
  flex: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180rpx;
  gap: 16rpx;
  align-items: center;
}

.price-input {
  min-height: 72rpx;
}

.remove-btn {
  margin: 0;
}

.compact-empty {
  padding: 28rpx 16rpx;
}

.calc-panel {
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 20rpx;
  background: #f9fafb;
}
