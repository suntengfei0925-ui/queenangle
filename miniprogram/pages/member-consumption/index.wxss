.member-summary {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.card-option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  box-sizing: border-box;
  border: 2rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #ffffff;
  padding: 18rpx 20rpx;
}

.card-option.active {
  border-color: #10b981;
  background: #ecfdf5;
  color: #065f46;
  font-weight: 600;
}

.service-picker {
  display: grid;
  grid-template-columns: 168rpx 1fr;
  height: 432rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
  background: #ffffff;
}

.category-list {
  max-height: 432rpx;
  overflow-y: auto;
  background: #f9fafb;
  border-right: 1rpx solid #e5e7eb;
}

.category-item {
  padding: 20rpx 16rpx;
  color: #4b5563;
  border-bottom: 1rpx solid #e5e7eb;
  word-break: break-all;
}

.category-item.active {
  background: #ffffff;
  color: #111827;
  font-weight: 600;
}

.service-list {
  height: 432rpx;
  box-sizing: border-box;
  padding: 12rpx;
}

.service-list-inner {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  padding: 0 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  box-sizing: border-box;
  text-align: center;
}

.service-item.selected {
  border-color: #10b981;
  background: #ecfdf5;
  color: #065f46;
  font-weight: 600;
}

.service-name {
  max-width: 4.5em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.selected-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-info {
  flex: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 180rpx;
  gap: 16rpx;
  align-items: center;
}

.selected-card-info {
  grid-template-columns: minmax(0, 1fr) 140rpx;
}

.price-input {
  min-height: 72rpx;
}

.remove-btn {
  margin: 0;
}

.compact-empty {
  padding: 28rpx 16rpx;
}

.calc-panel {
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 20rpx;
  background: #f9fafb;
}

.signature-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border: 1rpx solid #bbf7d0;
  border-radius: 10rpx;
  background: #f0fdf4;
  padding: 20rpx;
}

.signature-preview.invalid {
  border-color: #fecaca;
  background: #fef2f2;
}

.signature-thumb {
  width: 100%;
  height: 180rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  background: #ffffff;
}

.resign-btn {
  flex-shrink: 0;
  margin: 0;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.45);
}

.checkout-modal {
  display: flex;
  flex-direction: column;
  width: 620rpx;
  max-width: 100%;
  max-height: 78vh;
  border-radius: 12rpx;
  background: #ffffff;
  overflow: hidden;
}

.modal-title {
  padding: 28rpx 28rpx 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.modal-scroll {
  max-height: 58vh;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.confirm-section {
  margin-bottom: 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 18rpx;
  background: #ffffff;
}

.confirm-section-title {
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.confirm-row,
.confirm-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
}

.confirm-row > view:first-child,
.confirm-item-row > view:first-child {
  min-width: 0;
  word-break: break-all;
}

.highlight-row {
  margin: 8rpx 0;
  border-radius: 8rpx;
  background: #fff7ed;
  padding: 14rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.confirm-item-list {
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #e5e7eb;
  padding-bottom: 8rpx;
}

.card-change {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-radius: 8rpx;
  background: #f9fafb;
  padding: 14rpx 16rpx;
}

.card-change + .card-change {
  margin-top: 12rpx;
}

.card-change-name {
  font-weight: 600;
}

.card-change-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #374151;
}

.modal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 20rpx 28rpx 28rpx;
}
