<view class="page">
  <view class="panel form">
    <view class="field">
      <view class="label">会员</view>
      <view class="select-list">
        <view
          wx:for="{{members}}"
          wx:key="_id"
          class="select-option {{item._id === selectedMember._id ? 'active' : ''}}"
          bindtap="onMemberChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.name}}</view>
          <view wx:if="{{item.phone}}" class="select-option-meta">{{item.phone}}</view>
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">次卡类型</view>
      <view class="select-list">
        <view
          wx:for="{{cardTypes}}"
          wx:key="_id"
          class="select-option {{item._id === selectedCardType._id ? 'active' : ''}}"
          bindtap="onCardTypeChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.name}}</view>
          <view class="select-option-meta">{{item.totalTimes}} 次卡 / ¥{{item.priceYuan}}</view>
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">购买次数</view>
      <input class="input" value="{{form.purchaseTimes}}" data-field="purchaseTimes" bindinput="onInput" type="number" />
    </view>
    <view class="field">
      <view class="label">实收金额</view>
      <input class="input" value="{{form.actualReceivedYuan}}" data-field="actualReceivedYuan" bindinput="onInput" type="digit" placeholder="单位：元" />
    </view>
    <view class="field">
      <view class="label">支付方式</view>
      <view class="select-list">
        <view
          wx:for="{{paymentMethods}}"
          wx:key="value"
          class="select-option {{item.value === selectedPayment.value ? 'active' : ''}}"
          bindtap="onPaymentChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.label}}</view>
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="submit">保存记录</button>
  </view>
</view>

