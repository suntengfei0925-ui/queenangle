
.edit-btn {
  margin: 0;
}

.card-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}

.member-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f9fafb;
}

.card-row {
  min-height: 52rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.action-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 190rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.primary-action {
  background: #111827;
  color: #ffffff;
  border-color: #111827;
}

.action-title {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 700;
}

.action-desc {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.primary-action .action-desc {
  color: #d1d5db;
}

.action-enter {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}
