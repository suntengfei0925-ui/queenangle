<view class="page">
  <view class="panel form">
    <view class="field">
      <view class="label">消费项目</view>
      <view class="service-picker">
        <view class="category-list">
          <view
            wx:for="{{categories}}"
            wx:key="_id"
            class="category-item {{item._id === activeCategoryId ? 'active' : ''}}"
            bindtap="selectCategory"
            data-id="{{item._id}}"
          >
            {{item.name}}
          </view>
        </view>
        <view class="service-list">
          <view
            wx:for="{{activeServices}}"
            wx:key="_id"
            class="service-item"
            bindtap="addService"
            data-id="{{item._id}}"
          >
            <view>{{item.name}}</view>
            <view wx:if="{{!item.isOther}}" class="muted small-text">{{item.usageCount}} 次</view>
          </view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="label">已选项目</view>
      <view wx:if="{{selectedItems.length === 0}}" class="empty compact-empty">请选择服务项目</view>
      <view class="selected-list" wx:else>
        <view class="selected-item" wx:for="{{selectedItems}}" wx:key="key">
          <view class="selected-info">
            <view class="sub-title">{{item.displayName}}</view>
            <input class="input price-input" value="{{item.originalAmountYuan}}" data-index="{{index}}" bindinput="onItemAmountInput" type="digit" placeholder="单项原价" />
          </view>
          <button class="secondary remove-btn" size="mini" bindtap="removeItem" data-index="{{index}}">移除</button>
        </view>
      </view>
    </view>

    <view class="row total-row">
      <view class="muted">整单原价</view>
      <view class="money title">¥{{totalOriginalYuan}}</view>
    </view>

    <view class="field">
      <view class="label">实际收款金额</view>
      <input class="input" value="{{form.actualReceivedYuan}}" data-field="actualReceivedYuan" bindinput="onInput" type="digit" placeholder="单位：元" />
    </view>
    <view class="field">
      <view class="label">支付方式</view>
      <view class="select-list">
        <view
          wx:for="{{paymentMethods}}"
          wx:key="value"
          class="select-option {{item.value === selectedPayment.value ? 'active' : ''}}"
          bindtap="onPaymentChange"
          data-index="{{index}}"
        >
          <view class="select-option-title">{{item.label}}</view>
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="可选" />
    </view>
    <button class="primary" bindtap="submit">保存记录</button>
  </view>
</view>
