.signature-page {
  display: grid;
  grid-template-rows: 40rpx minmax(0, 1fr) 56rpx;
  gap: 8rpx;
  height: 100vh;
  box-sizing: border-box;
  padding: 8rpx 18rpx;
  background: #f6f7f9;
}

.signature-title {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.signature-canvas {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 2rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #ffffff;
}

.signature-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.signature-actions button {
  min-height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 24rpx;
}
