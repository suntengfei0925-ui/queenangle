<view class="signature-page">
  <view class="signature-title">请客户签字确认</view>
  <canvas
    class="signature-canvas"
    canvas-id="signatureCanvas"
    disable-scroll="true"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
  ></canvas>
  <view class="signature-actions">
    <button class="secondary" bindtap="clearSignature">清空重签</button>
    <button class="primary" bindtap="confirmSignature">确认签字</button>
  </view>
</view>
