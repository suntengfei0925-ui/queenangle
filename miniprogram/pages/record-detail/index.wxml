<view class="page">
  <view class="section panel stack">
    <view class="row">
      <view class="title">{{record.typeText}}</view>
      <view class="tag {{record.status === 'void' ? 'red' : 'gray'}}">{{record.statusText}}</view>
    </view>
    <view class="muted">{{record.timeText}}</view>
    <view wx:if="{{record.status === 'void'}}" class="danger">作废原因：{{record.voidReason || "-"}}</view>
  </view>

  <view class="section panel stack">
    <view wx:for="{{rows}}" wx:key="label" class="row">
      <view class="muted">{{item.label}}</view>
      <view class="record-value">{{item.value}}</view>
    </view>
  </view>

  <view wx:if="{{record.cardItems.length > 0}}" class="section panel stack">
    <view class="sub-title">{{record.type === 'member_initial_balance' ? '初始次卡' : '次卡明细'}}</view>
    <view wx:for="{{record.cardItems}}" wx:key="key" class="row">
      <view>{{item.cardName}}</view>
      <view wx:if="{{record.type === 'card_purchase'}}" class="money">+{{item.purchaseTimes}} 次 / ¥{{item.priceYuan}}</view>
      <view wx:elif="{{record.type === 'member_initial_balance'}}" class="money">初始 {{item.initialTimes}} 次</view>
      <view wx:else class="money">扣 {{item.useTimes}} 次，剩余 {{item.remainingTimesAfter}} 次</view>
    </view>
  </view>

  <view wx:if="{{record.serviceItems.length > 0}}" class="section panel stack">
    <view class="sub-title">项目明细</view>
    <view wx:for="{{record.serviceItems}}" wx:key="key" class="row">
      <view>{{item.displayName}}</view>
      <view class="money">¥{{item.priceYuan}}</view>
    </view>
  </view>

  <view wx:if="{{record.remark}}" class="section panel stack">
    <view class="sub-title">备注</view>
    <view>{{record.remark}}</view>
  </view>

  <view wx:if="{{record.signatureFileId}}" class="section panel stack">
    <view class="sub-title">客户签名</view>
    <view class="row">
      <view class="muted">签字时间</view>
      <view>{{record.signatureSignedAtText}}</view>
    </view>
    <image class="signature-image" src="{{record.signatureFileId}}" mode="aspectFit" bindtap="previewSignature" />
  </view>

  <view wx:if="{{record.status === 'active'}}" class="button-row">
    <button class="danger-btn" bindtap="voidRecord">作废记录</button>
  </view>
</view>

