NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public site settings.
DOMAIN=example.com
APP_ORIGIN=https://example.com
COOKIE_SECURE=true

# Generate a real value on the server:
# openssl rand -base64 48
SESSION_SECRET=replace-with-a-real-random-secret-at-least-32-chars
SESSION_TTL_MS=1209600000

# Container paths. Do not change unless docker-compose.prod.yml is changed too.
DB_PATH=/data/db/queenangle.sqlite
UPLOAD_DIR=/data/uploads

# Optional when the default Node image cannot be pulled.
# NODE_IMAGE=node:22-bookworm

# Initial production accounts. Replace before first boot.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-owner-password
OWNER_NAME=Owner
PARTNER_USERNAME=partner
PARTNER_PASSWORD=change-this-partner-password
PARTNER_NAME=Partner
